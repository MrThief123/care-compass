# Copy this file to .env.local and fill in real values (never commit .env.local).
# Local values come from `supabase status` after `supabase start` (see README).

# Public — safe to expose to the browser, read by src/lib/env.ts and src/lib/supabase/browser.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never reference from client code. Optional in local dev; required for
# src/server/jobs/supabase-admin.ts, which throws a descriptive error only when invoked
# without it. An ESLint rule restricts importing that module outside src/server/jobs/**.
SUPABASE_SERVICE_ROLE_KEY=

# INT-01 budget threshold emails (server-only; set in the Vercel project, see
# docs/development/shared/shared-budget-threshold-emails/DECISIONS.md FD-02 and FD-06).
# RESEND_FROM_EMAIL must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Manual trigger: POST with header x-jobs-secret.
JOBS_SECRET=
# Vercel Cron calls GET with `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
